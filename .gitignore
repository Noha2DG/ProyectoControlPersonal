node_modules/

# Contiene la cadena de conexión real de MySQL (ver backend/.env en su lugar)
CLAUDE.md

# Config local de Claude Code, no se comparte
.claude/settings.local.json

# Fotos reales de empleados — nunca al historial de git
backend/uploads/fotos/*
!backend/uploads/fotos/.gitkeep

# Respaldos de datos (contienen datos sensibles) — nunca al historial de git
backend/backup_*.json

# Logs de sesiones de prueba con el navegador (webapp-testing / Playwright MCP)
.playwright-mcp/

# Índice local de CodeGraph — cache regenerable, no se comparte
.codegraph/

# Respaldos que dejan los editores y los scripts al reescribir un archivo (*.ps1.bak, *.ts.bak).
# El original ya esta versionado: la copia solo agrega ruido y se sube por accidente.
*.bak

# Empaquetados de herramientas/ para repartir a las estaciones. Son una foto de archivos que git ya
# versiona: al quedar desactualizados alguien instala una version vieja sin darse cuenta.
*.rar
